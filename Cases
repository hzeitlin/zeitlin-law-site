        let activeCategory = 'all';

        function renderCases(cases) {
            const grid = document.getElementById('casesGrid');
            const noRes = document.getElementById('noResults');
            grid.innerHTML = '';

            if (cases.length === 0) {
                noRes.classList.remove('hidden');
                return;
            } else {
                noRes.classList.add('hidden');
            }

            cases.forEach((c, idx) => {
                const card = document.createElement('div');
                card.className = "bg-[#101B26] border border-slate-800 rounded-xl p-6 flex flex-col justify-between card-glow transition cursor-pointer";
                card.onclick = () => openModal(c);

                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-[11px] uppercase tracking-wider text-[#C5A059] font-semibold">${c.type} (${c.year})</span>
                            <span class="text-xs bg-[#0A1118] text-slate-400 px-2 py-1 rounded border border-slate-800">${c.cat.includes('az') ? 'AZ' : 'MD/FED'}</span>
                        </div>
                        <h3 class="text-xl font-serif text-white font-bold mb-3">${c.title}</h3>
                        <p class="text-slate-400 text-xs line-clamp-3 leading-relaxed mb-6">${c.desc}</p>
                    </div>
                    <div class="border-t border-slate-800/80 pt-4 flex items-center justify-between mt-auto">
                        <div>
                            <span class="text-[10px] text-slate-500 uppercase block">Initial Offer</span>
                            <span class="text-sm font-medium text-rose-400/90">${c.offer}</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] text-slate-500 uppercase block">Total Recovery</span>
                            <span class="text-base font-bold text-emerald-400">${c.recovery}</span>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterCases() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const filtered = casesData.filter(c => {
                const matchesQuery = c.title.toLowerCase().includes(query) || c.desc.toLowerCase().includes(query) || c.type.toLowerCase().includes(query);
                const matchesCat = activeCategory === 'all' || c.cat.includes(activeCategory);
                return matchesQuery && matchesCat;
            });
            renderCases(filtered);
        }

        function setCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn px-4 py-2 rounded-lg bg-[#0A1118] border border-slate-700 text-slate-300 hover:text-[#C5A059] transition";
            });
            const activeBtn = document.getElementById('cat-' + cat);
            if(activeBtn) {
                activeBtn.className = "cat-btn px-4 py-2 rounded-lg bg-[#C5A059] text-black font-semibold transition";
            }
            filterCases();
        }

        function openModal(c) {
            document.getElementById('mType').innerText = `${c.type} (${c.year})`;
            document.getElementById('mTitle').innerText = c.title;
            document.getElementById('mOffer').innerText = c.offer;
            document.getElementById('mRecovery').innerText = c.recovery;
            document.getElementById('mDesc').innerText = c.desc;
            document.getElementById('caseModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('caseModal').classList.add('hidden');
        }

        // Initial Render
        renderCases(casesData);
    </script>
</body>
</html>
